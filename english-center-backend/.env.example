# Server Configuration
PROJECT_NAME="English Center Management System"
API_V1_STR="/api"
PORT=5000
HOST="0.0.0.0"
DEBUG=True

# CORS
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Security & JWT
JWT_SECRET_KEY="english-center-super-secret-jwt-key-change-in-production-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL Async)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/english_center_db"

# Redis Configuration (Optional for caching and distributed locks)
REDIS_URL="redis://localhost:6379/0"

# Default Center Admin Credentials for seeding
DEFAULT_SUPERADMIN_EMAIL="super@saas.com"
DEFAULT_SUPERADMIN_PASSWORD="Password123@"
DEFAULT_ADMIN_EMAIL="admin@center.edu.vn"
DEFAULT_ADMIN_PASSWORD="Password123@"
DEFAULT_TEACHER_EMAIL="teacher@center.edu.vn"
DEFAULT_TEACHER_PASSWORD="Password123@"

